<?xml version="1.0" encoding="utf-8"?>

<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardBackgroundColor="@color/night_3"
    app:cardCornerRadius="16dp"
    app:strokeColor="@color/border"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:padding="10dp"
                android:background="@drawable/bg_light_icon"
                android:src="@drawable/ic_light"
                app:tint="@color/amber"
                android:contentDescription="@string/light" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="12dp">

                <TextView
                    android:id="@+id/txtDeviceLightName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/white"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtDeviceLightRoom"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/mist"
                    android:textSize="12sp" />

            </LinearLayout>

            <TextView
                android:id="@+id/txtDeviceLightStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/amber"
                android:textSize="10sp"
                android:paddingHorizontal="8dp"
                android:paddingVertical="5dp"
                android:background="@drawable/bg_status_on" />

        </LinearLayout>

        <TextView
            android:id="@+id/txtDeviceLightTopic"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/cyan"
            android:textSize="11sp"
            android:fontFamily="monospace"
            android:padding="9dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_topic" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="10dp">

            <Button
                android:id="@+id/btnEditLight"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/edit"
                android:textColor="@color/mist"
                android:backgroundTint="@color/night_2" />

            <Button
                android:id="@+id/btnDeleteLight"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/delete"
                android:textColor="@color/danger"
                android:backgroundTint="@color/night_2"
                android:layout_marginStart="8dp" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>