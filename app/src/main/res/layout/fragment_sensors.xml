<?xml version="1.0" encoding="utf-8"?>

<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/night"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="22dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Sensors"
            android:textColor="@color/white"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Live readings from the ESP32 controller"
            android:textColor="@color/mist"
            android:textSize="13sp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="20dp" />


        <!-- LDR -->

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/night_3"
            app:cardCornerRadius="18dp"
            app:strokeColor="@color/border"
            app:strokeWidth="1dp"
            android:layout_marginBottom="22dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="18dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <FrameLayout
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:background="@drawable/bg_sensor_gauge">

                    <TextView
                        android:id="@+id/txtLdrValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="42"
                        android:textColor="@color/white"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Ambient light"
                        android:textColor="@color/white"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtLdrLocation"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Hallway LDR sensor"
                        android:textColor="@color/mist"
                        android:textSize="12sp"
                        android:layout_marginTop="4dp" />

                    <TextView
                        android:id="@+id/txtAmbientStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="DARK · AUTO ON"
                        android:textColor="@color/cyan"
                        android:textSize="11sp"
                        android:layout_marginTop="8dp" />

                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>


        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="MOTION SENSORS"
            android:textColor="@color/gray_text"
            android:textSize="11sp"
            android:letterSpacing="0.08"
            android:layout_marginBottom="12dp" />


        <!-- PIR 1 -->

        <include
            layout="@layout/item_pir_sensor"
            android:id="@+id/pirSensor1" />

        <!-- PIR 2 -->

        <include
            layout="@layout/item_pir_sensor"
            android:id="@+id/pirSensor2" />

        <!-- PIR 3 -->

        <include
            layout="@layout/item_pir_sensor"
            android:id="@+id/pirSensor3" />


        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="RECENT ACTIVITY"
            android:textColor="@color/gray_text"
            android:textSize="11sp"
            android:letterSpacing="0.08"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="12dp" />


        <LinearLayout
            android:id="@+id/activityLog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="●  PIR 1 detected motion → Light 1 ON"
                android:textColor="@color/mist"
                android:textSize="12sp"
                android:padding="10dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="●  LDR reading dropped below threshold"
                android:textColor="@color/mist"
                android:textSize="12sp"
                android:padding="10dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="●  PIR 3 idle → Light 3 OFF"
                android:textColor="@color/mist"
                android:textSize="12sp"
                android:padding="10dp" />

        </LinearLayout>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>